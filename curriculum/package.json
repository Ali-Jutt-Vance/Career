{
  "name": "career-book",
  "version": "2.0.0",
  "description": "Career Book — Software Engineering Mastery. 96 core chapters, a dated 252-day execution plan, and a desktop reader app.",
  "scripts": {
    "build": "node build.js",
    "build:all": "node build.js --all",
    "pdf": "node build.js --pdf",
    "plan": "node plan/build-plan.js",
    "reader": "node compile.js --html-only",
    "icon": "node app/make-icon.js",
    "install:app": "powershell -ExecutionPolicy Bypass -File app/install-app.ps1",
    "test": "node plan/smoke-test.js",
    "compile:phase": "node compile.js --phase"
  },
  "dependencies": {
    "fs-extra": "^11.4.1",
    "glob": "^13.0.6",
    "highlight.js": "^11.12.0",
    "marked": "^12.0.2",
    "marked-highlight": "^2.2.4",
    "puppeteer": "^25.12.0"
  }
}
